generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// ENUMS
// ============================================

enum CoupleRole {
  OWNER
  MEMBER
}

enum SavingsGoalStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

// ============================================
// USUARIO (Auth.js + NEXO)
// ============================================

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  passwordHash  String
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Auth.js
  accounts Account[]
  sessions Session[]

  // NEXO
  coupleMember    CoupleMember?
  invitationsSent CoupleInvitation[]
  contributions   SavingsContribution[]
}

// ============================================
// PAREJA
// ============================================

model Couple {
  id          String   @id @default(cuid())
  memberCount Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members       CoupleMember[]
  invitations   CoupleInvitation[]
  contributions SavingsContribution[]
  goals         SavingsGoal[]
}

// ============================================
// MIEMBRO DE PAREJA
// ============================================

model CoupleMember {
  id       String     @id @default(cuid())
  coupleId String
  userId   String     @unique
  role     CoupleRole @default(MEMBER)
  joinedAt DateTime   @default(now())

  couple Couple @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([coupleId, userId])
  @@index([coupleId])
}

// ============================================
// INVITACIÓN DE PAREJA
// ============================================

model CoupleInvitation {
  id          String    @id @default(cuid())
  coupleId    String
  code        String    @unique
  createdById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  couple    Couple @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  createdBy User   @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([coupleId])
}

// ============================================
// APORTES
// ============================================

model SavingsContribution {
  id               String   @id @default(cuid())
  coupleId         String
  userId           String
  goalId           String?
  amount           Decimal  @db.Decimal(14, 2)
  note             String?  @db.VarChar(280)
  contributionDate DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  couple Couple       @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal   SavingsGoal? @relation(fields: [goalId], references: [id], onDelete: SetNull)

  @@index([coupleId, contributionDate])
  @@index([userId])
  @@index([goalId])
}

// ============================================
// METAS
// ============================================

model SavingsGoal {
  id           String             @id @default(cuid())
  coupleId     String
  name         String             @db.VarChar(120)
  description  String?            @db.VarChar(500)
  targetAmount Decimal            @db.Decimal(14, 2)
  targetDate   DateTime?
  status       SavingsGoalStatus  @default(ACTIVE)
  completedAt  DateTime?
  archivedAt   DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  couple        Couple                @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  contributions SavingsContribution[]

  @@index([coupleId, status])
  @@index([coupleId, createdAt])
}

// ============================================
// MODELOS DE AUTH.JS
// ============================================

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}