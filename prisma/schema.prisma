generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// ENUMS
// ============================================

enum CoupleRole {
  OWNER
  MEMBER
}

enum SavingsGoalStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum NotificationType {
  CONTRIBUTION_CREATED
  WITHDRAWAL_CREATED
}

// ============================================
// USUARIO (Auth.js + NEXO)
// ============================================

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  passwordHash  String
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Auth.js
  accounts Account[]
  sessions Session[]

  // NEXO
  coupleMember    CoupleMember?
  invitationsSent CoupleInvitation[]
  contributions   SavingsContribution[]
  withdrawals     SavingsWithdrawal[]
  notificationsReceived InAppNotification[] @relation("NotificationRecipient")
  notificationsSent     InAppNotification[] @relation("NotificationActor")
}

// ============================================
// PAREJA
// ============================================

model Couple {
  id          String   @id @default(cuid())
  memberCount Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members       CoupleMember[]
  invitations   CoupleInvitation[]
  contributions SavingsContribution[]
  withdrawals   SavingsWithdrawal[]
  goals         SavingsGoal[]
  monthlyTargets MonthlyTarget[]

}

// ============================================
// MIEMBRO DE PAREJA
// ============================================

model CoupleMember {
  id       String     @id @default(cuid())
  coupleId String
  userId   String     @unique
  role     CoupleRole @default(MEMBER)
  joinedAt DateTime   @default(now())

  couple Couple @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([coupleId, userId])
  @@index([coupleId])
}

// ============================================
// INVITACIÓN DE PAREJA
// ============================================

model CoupleInvitation {
  id          String    @id @default(cuid())
  coupleId    String
  code        String    @unique
  createdById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  couple    Couple @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  createdBy User   @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([coupleId])
}

// ============================================
// APORTES
// ============================================

model SavingsContribution {
  id               String   @id @default(cuid())
  coupleId         String
  userId           String
  goalId           String?
  amount           Decimal  @db.Decimal(14, 2)
  note             String?  @db.VarChar(280)
  contributionDate DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  couple Couple       @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal   SavingsGoal? @relation(fields: [goalId], references: [id], onDelete: SetNull)
  notifications InAppNotification[]

  @@index([coupleId, contributionDate])
  @@index([userId])
  @@index([goalId])
}

model SavingsWithdrawal {
  id             String   @id @default(cuid())
  coupleId       String
  userId         String
  goalId         String?
  amount         Decimal  @db.Decimal(14, 2)
  note           String?  @db.VarChar(280)
  withdrawalDate DateTime @default(now())
  createdAt      DateTime @default(now())

  couple Couple       @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal   SavingsGoal? @relation(fields: [goalId], references: [id], onDelete: SetNull)
  notifications InAppNotification[]

  @@index([coupleId, withdrawalDate])
  @@index([userId])
  @@index([goalId])
}

model InAppNotification {
  id             String           @id @default(cuid())
  recipientId    String
  actorId        String
  contributionId String?
  withdrawalId   String?
  type           NotificationType @default(CONTRIBUTION_CREATED)
  readAt         DateTime?
  createdAt      DateTime         @default(now())

  recipient    User                @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor        User                @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)
  contribution SavingsContribution? @relation(fields: [contributionId], references: [id], onDelete: Cascade)
  withdrawal   SavingsWithdrawal?   @relation(fields: [withdrawalId], references: [id], onDelete: Cascade)

  @@index([recipientId, readAt, createdAt])
  @@index([withdrawalId])
}

model AuthRateLimit {
  id             String   @id @default(cuid())
  keyHash        String   @unique @db.Char(64)
  attempts       Int      @default(0)
  windowStartedAt DateTime @default(now())
  blockedUntil   DateTime?
  updatedAt      DateTime @updatedAt

  @@index([updatedAt])
}

// ============================================
// METAS
// ============================================

model SavingsGoal {
  id           String             @id @default(cuid())
  coupleId     String
  name         String             @db.VarChar(120)
  description  String?            @db.VarChar(500)
  targetAmount Decimal            @db.Decimal(14, 2)
  targetDate   DateTime?
  status       SavingsGoalStatus  @default(ACTIVE)
  completedAt  DateTime?
  archivedAt   DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  couple        Couple                @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  contributions SavingsContribution[]
  withdrawals   SavingsWithdrawal[]

  @@index([coupleId, status])
  @@index([coupleId, createdAt])
}

// ============================================
// MODELOS DE AUTH.JS
// ============================================

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================
// OBJETIVO MENSUAL DE AHORRO
// ============================================

model MonthlyTarget {
  id           String   @id @default(cuid())
  coupleId     String
  year         Int
  month        Int
  targetAmount Decimal  @db.Decimal(14, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  couple Couple @relation(fields: [coupleId], references: [id], onDelete: Cascade)

  @@unique([coupleId, year, month])
  @@index([coupleId])
}